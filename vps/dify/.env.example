# ── Dify Environment Configuration ──────────────────────────────────────────
# Copy to .env and fill in real values before running docker compose up

# ── Core secrets (generate with: openssl rand -hex 32) ───────────────────────
SECRET_KEY=your-secret-key-32-chars-minimum-change-this
INIT_PASSWORD=your-dify-admin-password

# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME=dify
DB_PASSWORD=change-this-db-password
DB_HOST=db
DB_PORT=5432
DB_DATABASE=dify

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password
REDIS_USE_SSL=false
REDIS_DB=0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=storage

# ── Vector store ──────────────────────────────────────────────────────────────
VECTOR_STORE=weaviate
WEAVIATE_ENDPOINT=http://weaviate:8080
WEAVIATE_API_KEY=weaviate-secret-key

# ── Sandbox ───────────────────────────────────────────────────────────────────
SANDBOX_API_KEY=sandbox-secret-key
CODE_EXECUTION_ENDPOINT=http://sandbox:8194
CODE_EXECUTION_API_KEY=sandbox-secret-key

# ── App URLs (set to your actual domain) ─────────────────────────────────────
CONSOLE_WEB_URL=https://dify.believeth.net
CONSOLE_API_URL=https://dify.believeth.net
SERVICE_API_URL=https://dify.believeth.net
APP_WEB_URL=https://dify.believeth.net

# ── Mail (optional — DirectAdmin SMTP) ───────────────────────────────────────
MAIL_TYPE=smtp
MAIL_DEFAULT_SEND_FROM=noreply@believeth.net
SMTP_SERVER=localhost
SMTP_PORT=587
SMTP_USERNAME=noreply@believeth.net
SMTP_PASSWORD=your-email-password
SMTP_USE_TLS=true

# ── AI Provider API Keys ──────────────────────────────────────────────────────
# These are configured per-workspace inside Dify's UI after first login.
# Listing here as a reminder — do NOT commit .env to git.
#
# Anthropic (Claude):   https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
#
# OpenAI:               https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
#
# OpenRouter:           https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
